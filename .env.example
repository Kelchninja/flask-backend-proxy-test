# Copy to .env and adjust. All values are optional unless noted.

# --- application -------------------------------------------------------------
APP_NAME=flask-proxy-test-backend
# development | testing | production
APP_ENV=production
# REQUIRED when APP_ENV=production. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
# Shown in responses and the X-Served-By header; handy with multiple backends.
INSTANCE_ID=backend-1
# Reject request bodies above this size with 413 (bytes).
MAX_CONTENT_LENGTH=16777216
# Comma-separated Host allow-list. Empty accepts any Host header.
# TRUSTED_HOSTS=proxy.example.com,localhost:8000

# --- reverse proxy -----------------------------------------------------------
# How many proxies you control sit in front of this app. 0 disables the
# rewrite for that header. Trusting more hops than you run lets clients spoof.
PROXY_FIX_X_FOR=1
PROXY_FIX_X_PROTO=1
PROXY_FIX_X_HOST=1
PROXY_FIX_X_PORT=0
# Set to 1 if the proxy strips a path prefix and sends X-Forwarded-Prefix.
PROXY_FIX_X_PREFIX=0

# --- logging -----------------------------------------------------------------
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=json
LOG_HEALTH_REQUESTS=false
REQUEST_ID_HEADER=X-Request-ID

# --- responses ---------------------------------------------------------------
# Only enable once TLS termination is confirmed working end to end.
ENABLE_HSTS=false
HSTS_MAX_AGE=31536000

# --- limits for the test endpoints -------------------------------------------
MAX_DELAY_SECONDS=30
MAX_STREAM_SECONDS=120
MAX_STREAM_CHUNKS=1000
MAX_PAYLOAD_BYTES=10485760
MAX_ECHO_BODY_BYTES=65536

# --- gunicorn ----------------------------------------------------------------
BIND=0.0.0.0:8000
WEB_CONCURRENCY=4
THREADS=4
# Must exceed MAX_STREAM_SECONDS.
TIMEOUT=150
KEEPALIVE=15
# Peers allowed to set X-Forwarded-*; use the proxy IP, or "*" in a private network.
FORWARDED_ALLOW_IPS=127.0.0.1
GUNICORN_LOG_LEVEL=info
